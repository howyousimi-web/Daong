{
  "name": "daong",
  "version": "1.0.0",
  "private": true,
  "description": "DAONG \u2014 Philippine disaster-relief donation tracker. Frontend, application API and AI assistant backend served as one app.",
  "main": "server/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "build:functions": "sh scripts/build-functions.sh",
    "deploy": "npm run build:functions && firebase deploy"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "optionalDependencies": {
    "@google-cloud/recaptcha-enterprise": "^7.1.0",
    "firebase-admin": "^12.7.0"
  }
}
