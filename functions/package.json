{
  "name": "daong-functions",
  "version": "1.0.0",
  "private": true,
  "description": "DAONG API as a Firestore-backed Cloud Function. Shares server/api-routes.js with the local Express server.",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions,firestore,hosting",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.1"
  },
  "optionalDependencies": {
    "@google-cloud/recaptcha-enterprise": "^7.1.0"
  }
}
